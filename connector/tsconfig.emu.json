{
  // エミュレーターの結合テスト（Node）。アプリの同期のエンジン（ブラウザの型を使う）も読み込むので DOM の型で確かめる
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.emu.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["test/emu"]
}
