{
  // テスト（Node の vitest・workerd の vitest）と設定ファイル。エミュレーターの結合テストは tsconfig.emu.json
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@cloudflare/workers-types", "node", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["test", "vitest.config.ts", "vitest.workers.config.ts", "vitest.emu.config.ts"],
  "exclude": ["test/emu"]
}
