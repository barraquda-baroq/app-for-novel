{
  "name": "novel-studio",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "test:sync": "firebase emulators:exec --config firebase.emu.json --only auth,firestore --project demo-novel-studio \"vitest run --config vitest.emu.config.ts\"",
    "test:e2e:sync": "firebase emulators:exec --config firebase.emu.json --only auth,firestore --project demo-novel-studio \"playwright test -c playwright.sync.config.ts\"",
    "test:connector": "npm --prefix connector test",
    "test:connector:emu": "firebase emulators:exec --config firebase.emu.json --only auth,firestore --project demo-novel-studio \"npm --prefix connector run test:emu\"",
    "connector:setup": "node connector/scripts/setup.mjs",
    "connector:check": "node connector/scripts/check.mjs",
    "deploy": "node scripts/deploy.mjs",
    "mobile:doctor": "node scripts/mobile.mjs doctor",
    "mobile:keystore": "node scripts/mobile.mjs keystore",
    "mobile:firebase": "node scripts/mobile.mjs firebase",
    "android:install": "node scripts/mobile.mjs android-install",
    "android:open": "node scripts/mobile.mjs android-open",
    "ios:open": "node scripts/mobile.mjs ios-open"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "dexie": "^4.4.7",
    "diff": "^8.0.4",
    "fflate": "^0.8.2",
    "firebase": "^13.1.0",
    "markdown-it": "15.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "markdown-it": {
      "argparse": "3.0.2"
    },
    "@capacitor-firebase/authentication": {
      "firebase": "$firebase"
    }
  }
}
